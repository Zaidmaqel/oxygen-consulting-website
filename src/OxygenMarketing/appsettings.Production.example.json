{
  "ConnectionStrings": {
    // SQLite default production path (ensure directory has write permissions for application pool/systemd user):
    "DefaultConnection": "Data Source=/var/data/oxygen/OxygenMarketing.db"

    // Alternative: Microsoft SQL Server connection string
    // "DefaultConnection": "Server=tcp:your-sql-server.database.windows.net,1433;Initial Catalog=OxygenMarketingDb;User ID=oxygen_admin;Password=YourPassword;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "AdminUser": {
    "Email": "admin@oxygen.jo",
    // Provide the admin password via environment variable (AdminUser__Password) or user secrets.
    // Must be at least 8 characters and contain uppercase, lowercase, and digit.
    "Password": "",
    "FullName": "Oxygen Executive Administrator"
  },
  "ContactSettings": {
    "NotificationEmail": "info@oxygen.jo"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "no-reply@oxygen.jo",
    "EnableSsl": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/oxygen/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "oxygen.jo;www.oxygen.jo"
}
