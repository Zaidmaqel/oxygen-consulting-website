@model List<OxygenMarketing.Models.Service>
@{
    ViewData["Title"] = "Services Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 fw-bold text-white mb-1">Services Management</h1>
    <p class="text-muted small m-0">Edit, reorder, or publish agency marketing services shown on public site.</p>
  </div>
  <a asp-action="Create" class="btn btn-gold-admin">
    <span>+</span> Add New Service
  </a>
</div>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle mb-0">
      <thead>
        <tr class="text-muted small">
          <th>Order</th>
          <th>Icon</th>
          <th>Title (English)</th>
          <th>Title (Arabic)</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var s in Model)
        {
          <tr>
            <td class="fw-bold">@s.SortOrder</td>
            <td>
              <span class="fs-5">
                @switch (s.Icon)
                {
                  case "compass": <span>🧭</span> break;
                  case "sparkles": <span>✨</span> break;
                  case "share-nodes": <span>🌐</span> break;
                  case "bullhorn": <span>📢</span> break;
                  case "chart-line": <span>📈</span> break;
                  default: <span>✦</span> break;
                }
              </span>
            </td>
            <td class="fw-bold text-white">@s.TitleEn</td>
            <td>@s.TitleAr</td>
            <td>
              @if (s.IsActive)
              {
                <span class="badge bg-success">Active</span>
              }
              else
              {
                <span class="badge bg-secondary">Disabled</span>
              }
            </td>
            <td class="text-end">
              <div class="d-flex justify-content-end gap-1">
                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-warning">
                  Edit
                </a>
                <form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Delete this service permanently? / هل أنت متأكد من الحذف؟');" class="d-inline">
                  @Html.AntiForgeryToken()
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
