@model OxygenMarketing.Models.Service
@{
    ViewData["Title"] = $"Edit Service — {Model.TitleEn}";
}

<div class="mb-4">
  <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">← Back to Services</a>
  <h1 class="h3 fw-bold text-white">Edit Service: @Model.TitleEn</h1>
</div>

<div class="admin-card" style="max-width: 800px;">
  <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
      <div class="col-md-6">
        <label asp-for="TitleEn" class="form-label small text-muted">Title (English) *</label>
        <input asp-for="TitleEn" class="form-control" required maxlength="150" />
        <span asp-validation-for="TitleEn" class="text-danger small"></span>
      </div>

      <div class="col-md-6">
        <label asp-for="TitleAr" class="form-label small text-muted">Title (Arabic) *</label>
        <input asp-for="TitleAr" class="form-control" required maxlength="150" dir="rtl" />
        <span asp-validation-for="TitleAr" class="text-danger small"></span>
      </div>

      <div class="col-12">
        <label asp-for="DescriptionEn" class="form-label small text-muted">Description (English) *</label>
        <textarea asp-for="DescriptionEn" class="form-control" rows="3" required maxlength="1000"></textarea>
        <span asp-validation-for="DescriptionEn" class="text-danger small"></span>
      </div>

      <div class="col-12">
        <label asp-for="DescriptionAr" class="form-label small text-muted">Description (Arabic) *</label>
        <textarea asp-for="DescriptionAr" class="form-control" rows="3" required maxlength="1000" dir="rtl"></textarea>
        <span asp-validation-for="DescriptionAr" class="text-danger small"></span>
      </div>

      <div class="col-md-4">
        <label asp-for="Icon" class="form-label small text-muted">Icon Key</label>
        <select asp-for="Icon" class="form-select">
          <option value="compass">Compass (Strategy)</option>
          <option value="sparkles">Sparkles (Content)</option>
          <option value="share-nodes">Share Nodes (Accounts)</option>
          <option value="bullhorn">Bullhorn (Paid Ads)</option>
          <option value="chart-line">Chart Line (Analytics)</option>
        </select>
      </div>

      <div class="col-md-4">
        <label asp-for="SortOrder" class="form-label small text-muted">Display Order</label>
        <input asp-for="SortOrder" class="form-control" type="number" min="0" />
      </div>

      <div class="col-md-4 d-flex align-items-end">
        <div class="form-check mb-2">
          <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
          <label class="form-check-label text-white" for="isActiveCheck">Published / Active</label>
        </div>
      </div>

      <div class="col-12 mt-4 pt-3 border-top border-secondary border-opacity-25">
        <button type="submit" class="btn btn-gold-admin px-4 py-2">Save Changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 ms-2">Cancel</a>
      </div>
    </div>
  </form>
</div>
