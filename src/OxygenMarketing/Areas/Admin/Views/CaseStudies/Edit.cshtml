@model OxygenMarketing.Models.CaseStudy
@{
    ViewData["Title"] = $"تعديل دراسة الحالة — {Model.TitleEn}";
}

<div class="mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
  <div>
    <a asp-action="Index" class="btn btn-sm btn-outline-warning mb-2 text-decoration-none">
      ← العودة لقائمة دراسات الحالة (Back to Case Studies)
    </a>
    <h1 class="h3 fw-bold text-white m-0">تعديل دراسة الحالة: <span class="text-gold-light">@(string.IsNullOrEmpty(Model.TitleAr) ? Model.TitleEn : Model.TitleAr)</span></h1>
    <p class="text-muted small mt-1 mb-0">عدّل بيانات الحملة، الأرقام والمؤشرات الحقيقية لتظهر في الموقع الرسمي للعملاء.</p>
  </div>
</div>

<div class="row g-4">
  <!-- Main Form Column -->
  <div class="col-xl-8">
    <div class="admin-card">
      <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" id="caseStudyForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImagePath" />

        <!-- 1. Basic Information -->
        <div class="mb-4 pb-3 border-bottom border-secondary border-opacity-25">
          <h2 class="h5 fw-bold text-gold-light mb-3">1. البيانات الأساسية • Basic Information</h2>
          <div class="row g-3">
            <div class="col-md-6">
              <label asp-for="TitleAr" class="form-label fw-semibold text-white">العنوان بالعربية (Title Arabic) *</label>
              <input asp-for="TitleAr" class="form-control bg-dark text-white border-secondary" required maxlength="150" dir="rtl" id="inputTitleAr" placeholder="مثال: دراسة حالة — قطاع ملابس" />
              <span asp-validation-for="TitleAr" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
              <label asp-for="TitleEn" class="form-label fw-semibold text-white">العنوان بالإنجليزية (Title English) *</label>
              <input asp-for="TitleEn" class="form-control bg-dark text-white border-secondary" required maxlength="150" id="inputTitleEn" placeholder="e.g. Case Study — Fashion & Apparel" />
              <span asp-validation-for="TitleEn" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
              <label asp-for="IndustryAr" class="form-label fw-semibold text-white">القطاع / المجال بالعربية (Sector Arabic) *</label>
              <input asp-for="IndustryAr" class="form-control bg-dark text-white border-secondary" required maxlength="100" dir="rtl" id="inputIndustryAr" placeholder="مثال: ملابس وأزياء فاخرة" />
              <span asp-validation-for="IndustryAr" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
              <label asp-for="IndustryEn" class="form-label fw-semibold text-white">القطاع بالإنجليزية (Sector English) *</label>
              <input asp-for="IndustryEn" class="form-control bg-dark text-white border-secondary" required maxlength="100" id="inputIndustryEn" placeholder="e.g. Fashion & Apparel" />
              <span asp-validation-for="IndustryEn" class="text-danger small"></span>
            </div>
          </div>
        </div>

        <!-- 2. Descriptions & Strategy -->
        <div class="mb-4 pb-3 border-bottom border-secondary border-opacity-25">
          <h2 class="h5 fw-bold text-gold-light mb-3">2. الاستراتيجية والتفاصيل • Strategy & Description</h2>
          <div class="row g-3">
            <div class="col-12">
              <label asp-for="DescriptionAr" class="form-label fw-semibold text-white">الوصف والاستراتيجية بالعربية (Strategy Arabic) *</label>
              <textarea asp-for="DescriptionAr" class="form-control bg-dark text-white border-secondary" rows="3" required maxlength="2000" dir="rtl" id="inputDescAr" placeholder="اشرح ما قمنا به: إعادة هيكلة الحملات، استهداف الجماهير، واختبار التصاميم..."></textarea>
              <span asp-validation-for="DescriptionAr" class="text-danger small"></span>
            </div>

            <div class="col-12">
              <label asp-for="DescriptionEn" class="form-label fw-semibold text-white">الوصف والاستراتيجية بالإنجليزية (Strategy English) *</label>
              <textarea asp-for="DescriptionEn" class="form-control bg-dark text-white border-secondary" rows="3" required maxlength="2000" id="inputDescEn" placeholder="Campaign restructuring, audience segmentation, creative testing..."></textarea>
              <span asp-validation-for="DescriptionEn" class="text-danger small"></span>
            </div>
          </div>
        </div>

        <!-- 3. Key Performance Indicators (KPIs) with Complete Clarity -->
        <div class="mb-4 p-4 rounded-3" style="background: rgba(199, 154, 59, 0.06); border: 1px solid rgba(199, 154, 59, 0.3);">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
              <h2 class="h5 fw-bold text-gold-light m-0">3. مؤشرات الأداء الحقيقية • Empirical KPIs & Metrics</h2>
              <small class="text-cream-soft d-block mt-1">هذه الأرقام تظهر في بطاقة دراسة الحالة على الصفحة الرئيسية لإبهار العملاء بنتائج أكسجين الدقيقة.</small>
            </div>
            <span class="badge bg-warning bg-opacity-25 text-gold-light px-3 py-2 border border-warning border-opacity-50">أرقام موثقة</span>
          </div>

          <!-- Helpful Instructions Callout -->
          <div class="alert alert-dark border-secondary p-3 mb-4 rounded-3 text-white small" style="background: rgba(20, 16, 11, 0.85);">
            <div class="fw-bold text-gold-light mb-1">💡 دليل تعبئة أرقام ومؤشرات الحملة:</div>
            <ul class="m-0 ps-3 pe-3" style="line-height: 1.8;">
              <li><strong>الميزانية المنفقة:</strong> أدخل المبلغ المصروف بالدولار الأمريكي $ (مثال: 700 سيظهر على الموقع $700).</li>
              <li><strong>الوصول الإعلاني:</strong> إجمالي عدد الأشخاص أو الحسابات الفريدة (مثال: 100000 سيظهر 100,000).</li>
              <li><strong>المحادثات المباشرة:</strong> عدد رسائل واستفسارات العملاء المحتملين عبر واتساب/ماسنجر (مثال: 3500 سيظهر 3,500).</li>
              <li><strong>تكلفة النقرة (CPC):</strong> متوسط تكلفة النقرة الواحدة بالدولار (مثال: 0.20 سيظهر $0.20).</li>
              <li><strong>تقييم الإبداع:</strong> علامة جودة وتأثير الفيديو والتصميم الإعلاني من 100 (مثال: 85 سيظهر 85/100).</li>
              <li><strong>نسبة التحسن:</strong> نسبة النمو والتحسن في المبيعات مقارنة بالسابق (مثال: 80 سيظهر +80%).</li>
            </ul>
          </div>

          <div class="row g-3">
            <!-- Metric 1: Budget -->
            <div class="col-md-6">
              <div class="p-3 bg-dark bg-opacity-75 rounded-3 border border-secondary border-opacity-50 h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label asp-for="Budget" class="form-label fw-bold text-white m-0">الميزانية المنفقة (Budget Spend)</label>
                  <span class="badge bg-secondary text-white small">بالدولار $ USD</span>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text bg-secondary bg-opacity-50 text-gold-light border-secondary fw-bold">$</span>
                  <input asp-for="Budget" class="form-control bg-dark text-white border-secondary fs-5 fw-bold" type="number" step="0.01" id="inputBudget" placeholder="700" />
                </div>
                <small class="text-white-50 d-block">إجمالي المبلغ المصروف على الحملة الإعلانية (مثال: 700)</small>
              </div>
            </div>

            <!-- Metric 2: Target Reach -->
            <div class="col-md-6">
              <div class="p-3 bg-dark bg-opacity-75 rounded-3 border border-secondary border-opacity-50 h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label asp-for="Reach" class="form-label fw-bold text-white m-0">الوصول الإعلاني (Target Reach)</label>
                  <span class="badge bg-secondary text-white small">عدد الحسابات الفريدة</span>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text bg-secondary bg-opacity-50 text-gold-light border-secondary">👥</span>
                  <input asp-for="Reach" class="form-control bg-dark text-white border-secondary fs-5 fw-bold" type="number" id="inputReach" placeholder="100000" />
                </div>
                <small class="text-white-50 d-block">عدد الأشخاص الفريدين الذين شاهدوا الإعلان (مثال: 100000)</small>
              </div>
            </div>

            <!-- Metric 3: Conversations -->
            <div class="col-md-6">
              <div class="p-3 bg-dark bg-opacity-75 rounded-3 border border-secondary border-opacity-50 h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label asp-for="Conversations" class="form-label fw-bold text-white m-0">المحادثات والرسائل (Inquiries)</label>
                  <span class="badge bg-secondary text-white small">رسائل المبيعات</span>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text bg-secondary bg-opacity-50 text-gold-light border-secondary">💬</span>
                  <input asp-for="Conversations" class="form-control bg-dark text-white border-secondary fs-5 fw-bold" type="number" id="inputConversations" placeholder="3500" />
                </div>
                <small class="text-white-50 d-block">عدد محادثات الواتساب والماسنجر المباشرة الناتجة (مثال: 3500)</small>
              </div>
            </div>

            <!-- Metric 4: CPC -->
            <div class="col-md-6">
              <div class="p-3 bg-dark bg-opacity-75 rounded-3 border border-secondary border-opacity-50 h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label asp-for="Cpc" class="form-label fw-bold text-white m-0">تكلفة النقرة (Cost Per Click - CPC)</label>
                  <span class="badge bg-secondary text-white small">دولار لكل نقرة $</span>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text bg-secondary bg-opacity-50 text-gold-light border-secondary fw-bold">$</span>
                  <input asp-for="Cpc" class="form-control bg-dark text-white border-secondary fs-5 fw-bold" type="number" step="0.01" id="inputCpc" placeholder="0.20" />
                </div>
                <small class="text-white-50 d-block">متوسط سعر النقرة بالدولار (مثال: 0.20 ليدل على دقة الاستهداف)</small>
              </div>
            </div>

            <!-- Metric 5: Creative Score -->
            <div class="col-md-6">
              <div class="p-3 bg-dark bg-opacity-75 rounded-3 border border-secondary border-opacity-50 h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label asp-for="CreativeScore" class="form-label fw-bold text-white m-0">تقييم جودة الإبداع (Creative Score)</label>
                  <span class="badge bg-secondary text-white small">علامة من 100</span>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text bg-secondary bg-opacity-50 text-gold-light border-secondary">🎨</span>
                  <input asp-for="CreativeScore" class="form-control bg-dark text-white border-secondary fs-5 fw-bold" type="number" min="0" max="100" id="inputCreativeScore" placeholder="85" />
                  <span class="input-group-text bg-secondary bg-opacity-50 text-white-50 border-secondary">/ 100</span>
                </div>
                <small class="text-white-50 d-block">تقييم جاذبية الفيديو والتصميم الإعلاني (مثال: 85)</small>
              </div>
            </div>

            <!-- Metric 6: Improvement Rate -->
            <div class="col-md-6">
              <div class="p-3 bg-dark bg-opacity-75 rounded-3 border border-secondary border-opacity-50 h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label asp-for="ExtraPercent" class="form-label fw-bold text-white m-0">نسبة التحسن والنمو (Growth %)</label>
                  <span class="badge bg-secondary text-white small">نسبة مئوية %</span>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text bg-secondary bg-opacity-50 text-gold-light border-secondary fw-bold">+</span>
                  <input asp-for="ExtraPercent" class="form-control bg-dark text-white border-secondary fs-5 fw-bold" type="number" step="0.01" id="inputExtraPercent" placeholder="80" />
                  <span class="input-group-text bg-secondary bg-opacity-50 text-white-50 border-secondary">%</span>
                </div>
                <small class="text-white-50 d-block">نسبة تحسن أداء العميل مقارنة بما قبل أكسجين (مثال: 80)</small>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. Media & Display Settings -->
        <div class="mb-4 pb-3">
          <h2 class="h5 fw-bold text-gold-light mb-3">4. صورة الغلاف وحالة النشر • Cover & Settings</h2>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold text-white">تغيير صورة الغلاف (Replace Cover Image)</label>
              <input type="file" name="imageFile" class="form-control bg-dark text-white border-secondary" accept=".jpg,.jpeg,.png,.webp" id="inputCoverFile" />
              @if (!string.IsNullOrEmpty(Model.ImagePath))
              {
                <div class="mt-2 p-2 bg-dark rounded border border-secondary d-flex align-items-center gap-2">
                  <img src="@Model.ImagePath" alt="Cover Preview" style="height: 40px; width: 60px; object-fit: cover; border-radius: 4px;" id="currentCoverImg" />
                  <small class="text-white-50 text-truncate">@Model.ImagePath</small>
                </div>
              }
            </div>

            <div class="col-md-6">
              <label asp-for="SortOrder" class="form-label fw-semibold text-white">ترتيب الظهور (Display Order)</label>
              <input asp-for="SortOrder" class="form-control bg-dark text-white border-secondary" type="number" min="0" placeholder="0" />
              <small class="text-white-50">الرقم الأقل يظهر أولاً في قائمة المشاريع.</small>
            </div>

            <div class="col-md-6 d-flex align-items-center mt-3">
              <div class="form-check form-switch">
                <input asp-for="IsFeatured" class="form-check-input" type="checkbox" id="isFeaturedCheck" style="width: 2.4em; height: 1.2em; cursor: pointer;" />
                <label class="form-check-label text-white fw-bold ms-2" for="isFeaturedCheck">
                  ⭐ عرض دراسة الحالة على الصفحة الرئيسية (Featured on Home)
                </label>
              </div>
            </div>

            <div class="col-md-6 d-flex align-items-center mt-3">
              <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" style="width: 2.4em; height: 1.2em; cursor: pointer;" />
                <label class="form-check-label text-white fw-bold ms-2" for="isActiveCheck">
                  🟢 منشور ونشط للزوار (Published & Active)
                </label>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 d-flex gap-3">
          <button type="submit" class="btn btn-gold-admin px-5 py-3 fw-bold fs-6">
            💾 حفظ التعديلات (Save Changes)
          </button>
          <a asp-action="Index" class="btn btn-outline-secondary px-4 py-3">إلغاء (Cancel)</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Live Visual Card Preview Column -->
  <div class="col-xl-4">
    <div class="sticky-top" style="top: 90px;">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <h3 class="h6 fw-bold text-gold-light m-0">👁️ معاينة حية كما يراها العميل على الموقع:</h3>
        <span class="badge bg-success bg-opacity-25 text-success small">مباشر • Live</span>
      </div>

      <!-- Preview Case Study Card -->
      <div class="glass-card p-0 overflow-hidden" style="border: 1px solid rgba(199, 154, 59, 0.4); box-shadow: 0 15px 40px rgba(0,0,0,0.6);">
        <div class="position-relative">
          <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/cases/case-clothing.jpg" : Model.ImagePath)" id="previewCardImage" alt="Cover Preview" class="img-fluid w-100" style="height: 180px; object-fit: cover;" />
          <div class="position-absolute top-0 end-0 m-2">
            <span class="badge bg-dark bg-opacity-75 border border-warning text-gold-light px-2 py-1" id="previewCardIndustry">
              @(string.IsNullOrEmpty(Model.IndustryAr) ? "ملابس" : Model.IndustryAr)
            </span>
          </div>
        </div>

        <div class="p-3 text-start">
          <h4 class="h5 fw-bold text-white mb-2" id="previewCardTitle">
            @(string.IsNullOrEmpty(Model.TitleAr) ? Model.TitleEn : Model.TitleAr)
          </h4>
          <p class="small text-white-50 mb-3" style="line-height: 1.6; max-height: 60px; overflow: hidden;" id="previewCardDesc">
            @(string.IsNullOrEmpty(Model.DescriptionAr) ? Model.DescriptionEn : Model.DescriptionAr)
          </p>

          <!-- KPI Metric Pill Bar -->
          <div class="row g-1 text-center py-2 border-top border-bottom border-secondary border-opacity-25 mb-2" style="background: rgba(199, 154, 59, 0.08); border-radius: 8px;">
            <div class="col-4">
              <small class="text-white-50 d-block" style="font-size: 0.7rem;">الوصول</small>
              <span class="fw-bold text-gold-light small" id="previewReach">@(Model.Reach?.ToString("N0") ?? "100,000")</span>
            </div>
            <div class="col-4">
              <small class="text-white-50 d-block" style="font-size: 0.7rem;">المحادثات</small>
              <span class="fw-bold text-gold-light small" id="previewConversations">@(Model.Conversations?.ToString("N0") ?? "3,500")</span>
            </div>
            <div class="col-4">
              <small class="text-white-50 d-block" style="font-size: 0.7rem;">سعر النقرة</small>
              <span class="fw-bold text-gold-light small" id="previewCpc">$@(Model.Cpc?.ToString("F2") ?? "0.20")</span>
            </div>
          </div>

          <!-- Secondary KPIs -->
          <div class="d-flex justify-content-between align-items-center pt-2 small text-white-50">
            <span>الميزانية: <strong class="text-white" id="previewBudget">$@(Model.Budget?.ToString("N0") ?? "700")</strong></span>
            <span>التحسن: <strong class="text-success" id="previewGrowth">+@(Model.ExtraPercent?.ToString("F0") ?? "80")%</strong></span>
          </div>
        </div>
      </div>

      <div class="p-3 bg-dark rounded-3 border border-secondary border-opacity-25 mt-3 small text-white-50">
        <span class="text-gold-light fw-bold">✓ كل رقم تدخله هنا</span> يتم حسابه وعرضه بدقة في إحصائيات الموقع، صفحة دراسات الحالة، ورادار الأداء التفاعلي لشركة أكسجين.
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
  // Dynamic Live Preview Synchronizer
  function updatePreview() {
    const titleAr = document.getElementById('inputTitleAr')?.value;
    const titleEn = document.getElementById('inputTitleEn')?.value;
    const industryAr = document.getElementById('inputIndustryAr')?.value;
    const industryEn = document.getElementById('inputIndustryEn')?.value;
    const descAr = document.getElementById('inputDescAr')?.value;
    const budget = document.getElementById('inputBudget')?.value;
    const reach = document.getElementById('inputReach')?.value;
    const convs = document.getElementById('inputConversations')?.value;
    const cpc = document.getElementById('inputCpc')?.value;
    const growth = document.getElementById('inputExtraPercent')?.value;

    if (document.getElementById('previewCardTitle')) {
      document.getElementById('previewCardTitle').textContent = titleAr || titleEn || 'عنوان دراسة الحالة';
    }
    if (document.getElementById('previewCardIndustry')) {
      document.getElementById('previewCardIndustry').textContent = industryAr || industryEn || 'القطاع الإعلاني';
    }
    if (document.getElementById('previewCardDesc') && descAr) {
      document.getElementById('previewCardDesc').textContent = descAr;
    }
    if (document.getElementById('previewReach')) {
      document.getElementById('previewReach').textContent = reach ? Number(reach).toLocaleString() : '100,000';
    }
    if (document.getElementById('previewConversations')) {
      document.getElementById('previewConversations').textContent = convs ? Number(convs).toLocaleString() : '3,500';
    }
    if (document.getElementById('previewCpc')) {
      document.getElementById('previewCpc').textContent = cpc ? '$' + Number(cpc).toFixed(2) : '$0.20';
    }
    if (document.getElementById('previewBudget')) {
      document.getElementById('previewBudget').textContent = budget ? '$' + Number(budget).toLocaleString() : '$700';
    }
    if (document.getElementById('previewGrowth')) {
      document.getElementById('previewGrowth').textContent = growth ? '+' + Number(growth).toFixed(0) + '%' : '+80%';
    }
  }

  // Attach live event listeners
  const inputIds = ['inputTitleAr', 'inputTitleEn', 'inputIndustryAr', 'inputIndustryEn', 'inputDescAr', 'inputBudget', 'inputReach', 'inputConversations', 'inputCpc', 'inputCreativeScore', 'inputExtraPercent'];
  inputIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', updatePreview);
    }
  });

  // Image preview reader
  const fileInput = document.getElementById('inputCoverFile');
  if (fileInput) {
    fileInput.addEventListener('change', function (e) {
      if (this.files && this.files[0]) {
        const reader = new FileReader();
        reader.onload = function (evt) {
          const previewImg = document.getElementById('previewCardImage');
          if (previewImg) previewImg.src = evt.target.result;
        };
        reader.readAsDataURL(this.files[0]);
      }
    });
  }
</script>
}
