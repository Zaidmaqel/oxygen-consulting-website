@model List<OxygenMarketing.Models.ContactMessage>
@{
    ViewData["Title"] = "Inbound Messages Inbox";
    var filter = ViewBag.CurrentFilter as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 fw-bold text-white mb-1">Inbound Messages Inbox</h1>
    <p class="text-muted small m-0">Review client inquiries, campaign packages, and contact submissions.</p>
  </div>
  <div class="d-flex gap-2">
    <a asp-action="ExportCsv" class="btn btn-sm btn-outline-warning">
      <span>📥</span> Export to CSV
    </a>
  </div>
</div>

<!-- Filter Tabs -->
<div class="d-flex gap-2 mb-4">
  <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(filter) ? "btn-warning" : "btn-outline-secondary")">
    All Messages (@Model.Count)
  </a>
  <a asp-action="Index" asp-route-filter="unread" class="btn btn-sm @(filter == "unread" ? "btn-warning" : "btn-outline-secondary")">
    Unread Only
  </a>
</div>

<div class="admin-card">
  @if (Model.Count == 0)
  {
    <div class="text-center py-5 text-muted">
      <p class="fs-5">No messages found matching your criteria.</p>
    </div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle mb-0">
        <thead>
          <tr class="text-muted small">
            <th>Status</th>
            <th>Date (UTC)</th>
            <th>Name</th>
            <th>Email & Phone</th>
            <th>Company</th>
            <th>Service</th>
            <th>Campaign Details</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var m in Model)
          {
            <tr>
              <td>
                @if (!m.IsRead)
                {
                  <span class="badge bg-danger">New</span>
                }
                else
                {
                  <span class="badge bg-secondary">Read</span>
                }
              </td>
              <td class="small text-muted">@m.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
              <td class="fw-bold">@m.Name</td>
              <td class="small">
                <div>@m.Email</div>
                <div class="text-muted">@m.Phone</div>
              </td>
              <td class="text-muted small">@(m.Company ?? "—")</td>
              <td class="small">@(m.Service != null ? m.Service.TitleEn : "General")</td>
              <td class="small">
                @if (!string.IsNullOrEmpty(m.CampaignDetails))
                {
                  <span class="badge bg-warning bg-opacity-25 text-warning">Custom Studio Bundle</span>
                }
                else
                {
                  <span class="text-muted">—</span>
                }
              </td>
              <td class="text-end">
                <div class="d-flex justify-content-end gap-1">
                  <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-warning">
                    View
                  </a>
                  <form asp-action="Delete" asp-route-id="@m.Id" method="post" onsubmit="return confirm('Delete this inquiry permanently? / هل أنت متأكد من الحذف؟');" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
