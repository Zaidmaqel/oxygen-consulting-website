@model OxygenMarketing.Models.ErrorViewModel
@using System.Globalization
@{
    var isAr = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = isAr ? "حدث خطأ غير متوقع (500) | أكسجين للتسويق" : "Server Error (500) | Oxygen Marketing";
}

<section class="py-5 text-center min-vh-100 d-flex align-items-center justify-content-center" style="background: radial-gradient(circle at 50% 50%, #261D12 0%, var(--dark) 80%);">
  <div class="container py-5">
    <div class="display-1 fw-bold text-danger mb-2">500</div>
    <h1 class="h2 fw-bold text-white mb-3">
      @(isAr ? "حدث خطأ داخلي في الخادم" : "An Internal Server Error Occurred")
    </h1>
    <p class="fs-5 text-muted mb-4 mx-auto" style="max-width: 600px;">
      @(isAr ? "تم تسجيل تفاصيل هذا الخطأ في نظام السجلات وسيقوم فريق الدعم بمراجعته فوراً." : "Error telemetry has been logged. Our engineering team has been notified.")
    </p>

    @if (Model.ShowRequestId)
    {
      <p class="small text-muted mb-4">
        <code>Request ID: @Model.RequestId</code>
      </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn-gold fs-5 px-5 py-3">
      @(isAr ? "العودة إلى الصفحة الرئيسية" : "Return to Homepage")
    </a>
  </div>
</section>
