@inject OxygenMarketing.Services.ISettingsService SettingsService
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var targetCulture = currentCulture.StartsWith("ar") ? "en" : "ar";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var fbUrl = await SettingsService.GetSettingValueAsync("FacebookUrl", currentCulture, "https://www.facebook.com/oxygenmedia2022/");
    var igUrl = await SettingsService.GetSettingValueAsync("InstagramUrl", currentCulture, "https://www.instagram.com/oxygen_consulting__marketing");
    var phone = await SettingsService.GetSettingValueAsync("Phone", currentCulture, "+962796690421");
    var email = await SettingsService.GetSettingValueAsync("Email", currentCulture, "infooxygenmedia2022@gmail.com");
    var address = await SettingsService.GetSettingValueAsync("Address", currentCulture, "Sweifieh, Amman, Jordan");
}

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="row g-5 mb-5">
      <!-- Col 1: Brand & Slogan -->
      <div class="col-lg-4 col-md-6">
        <a asp-controller="Home" asp-action="Index" class="brand-logo-wrap d-inline-block mb-3" aria-label="Oxygen Consulting & Marketing">
          <img src="~/images/logo-official-dark.png" alt="Oxygen Consulting & Marketing" class="footer-logo" style="height: 48px; width: auto; object-fit: contain; filter: drop-shadow(0 2px 10px rgba(199, 154, 59, 0.2));" />
        </a>
        <p class="text-white-50 mb-4" style="line-height: 1.85; font-size: 0.95rem;">
          @(currentCulture.StartsWith("ar") ? "مؤسسة أكسجين للاستشارات والتسويق — نحوّل الميزانية الإعلانية إلى قرارات مبنية على البيانات لتعزيز نمو علامتك التجارية." : "Oxygen Consulting & Marketing — Transforming advertising budgets into data-driven decisions to accelerate your brand's authority and market presence.")
        </p>

        <!-- Social Media Icons (STRICTLY Facebook and Instagram only) -->
        <div class="d-flex align-items-center">
          <a href="@fbUrl" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Oxygen Facebook Page">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="@igUrl" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Oxygen Instagram Profile">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="col-lg-2 col-md-6">
        <h4 class="h6 text-uppercase fw-bold text-white mb-3" style="letter-spacing: 0.08em;">@(currentCulture.StartsWith("ar") ? "روابط سريعة" : "Quick Links")</h4>
        <ul class="list-unstyled m-0 p-0 d-flex flex-column gap-2">
          <li><a asp-controller="Home" asp-action="Index" class="footer-link">@(currentCulture.StartsWith("ar") ? "الرئيسية" : "Home")</a></li>
          <li><a asp-controller="Home" asp-action="About" class="footer-link">@(currentCulture.StartsWith("ar") ? "من نحن" : "About")</a></li>
          <li><a asp-controller="Home" asp-action="Services" class="footer-link">@(currentCulture.StartsWith("ar") ? "خدماتنا" : "Services")</a></li>
          <li><a asp-controller="Home" asp-action="Portfolio" class="footer-link">@(currentCulture.StartsWith("ar") ? "أعمالنا" : "Portfolio")</a></li>
          <li><a href="/#campaign-studio" class="footer-link text-gold-light">@(currentCulture.StartsWith("ar") ? "استوديو الحملات" : "Studio")</a></li>
          <li><a asp-controller="Home" asp-action="Contact" class="footer-link">@(currentCulture.StartsWith("ar") ? "تواصل معنا" : "Contact")</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & Language -->
      <div class="col-lg-2 col-md-6">
        <h4 class="h6 text-uppercase fw-bold text-white mb-3" style="letter-spacing: 0.08em;">@(currentCulture.StartsWith("ar") ? "المعلومات" : "Information")</h4>
        <ul class="list-unstyled m-0 p-0 mb-3">
          <li><a asp-controller="Home" asp-action="Privacy" class="footer-link">@Loc["PrivacyPolicy"]</a></li>
          <li><a asp-controller="Home" asp-action="Terms" class="footer-link">@Loc["TermsOfService"]</a></li>
        </ul>
        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="mt-2">
          @Html.AntiForgeryToken()
          <input type="hidden" name="culture" value="@targetCulture" />
          <input type="hidden" name="returnUrl" value="@returnUrl" />
          <button type="submit" class="lang-switcher-btn">
            @(targetCulture == "en" ? "English Version" : "النسخة العربية")
          </button>
        </form>
      </div>

      <!-- Col 4: Contact Coordinates -->
      <div class="col-lg-4 col-md-6">
        <h4 class="h6 text-uppercase fw-bold text-white mb-3" style="letter-spacing: 0.08em;">@Loc["ContactInfo"]</h4>
        <ul class="list-unstyled m-0 p-0 text-muted" style="line-height: 2;">
          <li class="d-flex align-items-center gap-2 mb-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>@address</span>
          </li>
          <li class="d-flex align-items-center gap-2 mb-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <a href="tel:@phone" class="text-decoration-none text-muted" dir="ltr">@phone</a>
          </li>
          <li class="d-flex align-items-center gap-2 mb-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <a href="mailto:@email" class="text-decoration-none text-muted">@email</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-4 border-top border-secondary border-opacity-25 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 text-muted small">
      <p class="m-0">
        &copy; @DateTime.UtcNow.Year @Loc["BrandName"]. @Loc["AllRightsReserved"].
      </p>
      <p class="m-0 text-gold-light" style="font-size: 0.85rem;">
        "Let Your Brand Breathe" • دع علامتك تتنفس
      </p>
    </div>
  </div>
</footer>
