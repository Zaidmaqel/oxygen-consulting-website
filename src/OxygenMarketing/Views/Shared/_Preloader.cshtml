@* Signature Iris Preloader with Golden Ring Animation *@
<div id="preloader" role="status" aria-live="polite" aria-label="Loading Oxygen Marketing">
  <div class="preloader-content text-center">
    <div class="preloader-ring-wrapper mb-4">
      <svg class="preloader-ring-svg" viewBox="0 0 140 140">
        <defs>
          <linearGradient id="preloaderGold" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#A67422" />
            <stop offset="50%" stop-color="#FBD965" />
            <stop offset="100%" stop-color="#C79A3B" />
          </linearGradient>
        </defs>
        <!-- Background track -->
        <circle cx="70" cy="70" r="58" fill="none" stroke="rgba(199, 154, 59, 0.15)" stroke-width="3" />
        <!-- Drawing gold ring -->
        <circle class="preloader-ring-circle" cx="70" cy="70" r="58" fill="none" stroke="url(#preloaderGold)" stroke-width="4" stroke-linecap="round" />
      </svg>
    </div>
    
    <!-- Logo wordmark inside preloader -->
    <div class="preloader-logo-wrap">
      <img src="~/images/logo-official-dark.png" alt="Oxygen Consulting & Marketing" style="max-width: 190px; height: auto;" />
    </div>
  </div>
</div>
