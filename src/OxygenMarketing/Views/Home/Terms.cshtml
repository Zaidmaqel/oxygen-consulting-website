@using System.Globalization
@{
    var isAr = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = isAr ? "الشروط والأحكام | مؤسسة أكسجين للاستشارات والتسويق" : "Terms of Service | Oxygen Consulting & Marketing";
}

<section class="py-5 text-center position-relative" style="padding-top: 130px !important; background: radial-gradient(circle at 50% 30%, #261D12 0%, var(--dark) 75%);">
  <div class="container py-4">
    <h1 class="display-4 fw-bold text-white mb-3">@Loc["TermsOfService"]</h1>
    <p class="fs-5 text-cream-soft mx-auto" style="max-width: 700px;">
      @(isAr ? "شروط وأحكام استخدام الموقع الإلكتروني وتقديرات الحملات." : "Terms and conditions governing website usage and campaign studio estimates.")
    </p>
  </div>
</section>

<section class="py-5">
  <div class="container py-4">
    <div class="glass-card p-4 p-md-5" style="line-height: 2;">
      @if (isAr)
      {
        <h2 class="h4 text-gold-light mb-3">١. قبول الشروط</h2>
        <p class="text-cream-soft mb-4">
          باستخدامك لموقع مؤسسة أكسجين للاستشارات والتسويق، فإنك تقر وتوافق على الالتزام بهذه الشروط والأحكام والامتثال لكافة القوانين والأنظمة المعمول بها في المملكة الأردنية الهاشمية.
        </p>

        <h2 class="h4 text-gold-light mb-3">٢. طبيعة تقديرات استوديو الحملات (إخلاء مسؤولية)</h2>
        <p class="text-cream-soft mb-4">
          كافة أرقام الميزانيات، نطاقات الوصول (Reach)، وتقديرات المحادثات المعروضة في "استوديو بناء الحملات" هي أرقام استرشادية تقريبية مبنية على نتائج حملات سابقة في السوق. لا تشكل هذه الأرقام أي ضمان تعاقدي أو وعد ثابت بالنتائج، حيث تخضع الحملات الفعلية لمتغيرات السوق، المنافسة، وسلوك الجمهور المستهدف.
        </p>

        <h2 class="h4 text-gold-light mb-3">٣. حقوق الملكية الفكرية</h2>
        <p class="text-cream-soft mb-4">
          جميع حقوق الطبع والنشر والعلامات التجارية والنصوص والتصاميم والشعارات الواردة في هذا الموقع هي ملكية حصرية لمؤسسة أكسجين للاستشارات والتسويق ويُحظر إعادة نشرها أو استنساخها دون إذن خطي مسبق.
        </p>

        <h2 class="h4 text-gold-light mb-3">٤. القانون الواجب التطبيق</h2>
        <p class="text-cream-soft m-0">
          تخضع هذه الشروط وتُفسر وفقاً للقوانين السارية في المملكة الأردنية الهاشمية، وتختص محاكم عمّان بأي نزاع قد ينشأ عنها.
        </p>
      }
      else
      {
        <h2 class="h4 text-gold-light mb-3">1. Acceptance of Terms</h2>
        <p class="text-cream-soft mb-4">
          By accessing and browsing the website of Oxygen Consulting &amp; Marketing, you agree to comply with and be bound by these Terms of Service and applicable laws within the Hashemite Kingdom of Jordan.
        </p>

        <h2 class="h4 text-gold-light mb-3">2. Nature of Campaign Studio Estimates (Disclaimer)</h2>
        <p class="text-cream-soft mb-4">
          All financial budget ranges, expected impressions/reach projections, and conversation volume estimates generated by our Campaign Studio configurator are illustrative approximations derived from historical campaign benchmarks. They do not constitute a formal contractual guarantee or warranty, as live advertising results naturally depend on market seasonality, ad spend auction dynamics, and industry variables.
        </p>

        <h2 class="h4 text-gold-light mb-3">3. Intellectual Property Rights</h2>
        <p class="text-cream-soft mb-4">
          All logos, visual identity assets, proprietary software algorithms, trademarks, and textual content are the exclusive intellectual property of Oxygen Consulting &amp; Marketing. Unauthorized reproduction, distribution, or reverse-engineering is strictly prohibited.
        </p>

        <h2 class="h4 text-gold-light mb-3">4. Governing Law</h2>
        <p class="text-cream-soft m-0">
          These Terms are governed by and construed in accordance with the laws of the Hashemite Kingdom of Jordan, with exclusive jurisdiction resting in the competent courts of Amman.
        </p>
      }
    </div>
  </div>
</section>
