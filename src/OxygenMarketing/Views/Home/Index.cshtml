            </div>
          </div>

          <!-- Button to Request Package (Prefills Contact Form) -->
          <div class="mt-4">
            <button type="button" class="btn-gold w-100 py-3 fs-5" id="studio-request-package-btn">
              <span>@Loc["RequestPackageBtn"]</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================
     7. BRAND PULSE RADAR & TELEMETRY DASHBOARD
     ========================================== -->
<section class="py-5" id="radar-section" aria-label="Brand Pulse Radar">
  <div class="container">
    <div class="text-center mb-5">
      <div class="section-badge">TELEMETRY</div>
      <h2 class="section-title">@Loc["RadarTitle"]</h2>
      <p class="section-subtitle">@Loc["RadarSubtitle"]</p>
    </div>

    <div class="row g-5 align-items-center" id="telemetry-dashboard">
      <!-- Radar Sweep Visual -->
      <div class="col-lg-6 text-center">
        <div class="radar-box" id="brand-pulse-radar">
          <svg viewBox="0 0 400 400" width="100%" height="100%" style="background: #14100B; border-radius: 50%; border: 2px solid rgba(199, 154, 59, 0.4); box-shadow: 0 0 40px rgba(0,0,0,0.8);">
            <!-- Concentric Grid Rings -->
            <circle cx="200" cy="200" r="160" fill="none" stroke="rgba(199, 154, 59, 0.2)" stroke-width="1" />
            <circle cx="200" cy="200" r="120" fill="none" stroke="rgba(199, 154, 59, 0.25)" stroke-width="1" />
            <circle cx="200" cy="200" r="80" fill="none" stroke="rgba(199, 154, 59, 0.3)" stroke-width="1" />
            <circle cx="200" cy="200" r="40" fill="none" stroke="rgba(199, 154, 59, 0.4)" stroke-width="1" />
            <!-- Axis lines -->
            <line x1="200" y1="20" x2="200" y2="380" stroke="rgba(199, 154, 59, 0.2)" stroke-width="1" />
            <line x1="20" y1="200" x2="380" y2="200" stroke="rgba(199, 154, 59, 0.2)" stroke-width="1" />
          </svg>

          <!-- Sweeping Radar Beam -->
          <div class="radar-sweep-line"></div>

          <!-- Pulsing Blip Nodes from Empirical Case Studies -->
          <div class="radar-blip" style="top: 30%; left: 65%;" data-title="@(isAr ? "قطاع الملابس" : "Fashion Apparel")" data-value="100,000 Reach" data-sub="CPC: $0.20 • 3,500 Convs"></div>
          <div class="radar-blip" style="top: 70%; left: 75%;" data-title="@(isAr ? "عيادات التجميل" : "Beauty Clinics")" data-value="$0.20 CPC" data-sub="Creative Score: 75"></div>
          <div class="radar-blip" style="top: 25%; left: 35%;" data-title="@(isAr ? "قطاع الإسكانات" : "Real Estate")" data-value="170,000 Reach" data-sub="3,000 Inquiries • CPC $0.50"></div>
          <div class="radar-blip" style="top: 60%; left: 25%;" data-title="@(isAr ? "المركز التعليمي" : "Education Academy")" data-value="$0.70 CPC" data-sub="@(isAr ? "انخفاض من 2.0$" : "Reduced from $2.00")"></div>

          <!-- Glass Tooltip Popover -->
          <div id="radar-glass-tooltip" class="glass-card position-absolute p-3 text-start" style="opacity: 0; pointer-events: none; transition: all 0.2s ease; z-index: 10; min-width: 180px;">
            <div id="radar-tooltip-title" class="fw-bold text-gold-light small"></div>
            <div id="radar-tooltip-val" class="h5 fw-bold text-white my-1"></div>
            <div id="radar-tooltip-sub" class="text-muted small"></div>
          </div>
        </div>
      </div>

      <!-- Dashboard Telemetry Cards & SVG Line Chart -->
      <div class="col-lg-6">
        <div class="glass-card p-4">
          <h4 class="h5 fw-bold text-white mb-4">@(isAr ? "مؤشرات الأداء المعتمدة (KPIs)" : "Accredited Performance KPIs")</h4>

          <!-- Live SVG Telemetry Chart -->
          <div class="mb-4">
            <svg viewBox="0 0 400 120" width="100%" height="90">
              <defs>
                <linearGradient id="chartGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#A67422" />
                  <stop offset="50%" stop-color="#FBD965" />
                  <stop offset="100%" stop-color="#C79A3B" />
                </linearGradient>
              </defs>
              <!-- Grid Lines -->
              <line x1="0" y1="30" x2="400" y2="30" stroke="#251F18" stroke-width="1" />
              <line x1="0" y1="70" x2="400" y2="70" stroke="#251F18" stroke-width="1" />
              <line x1="0" y1="110" x2="400" y2="110" stroke="#251F18" stroke-width="1" />
              <!-- Animated Telemetry Curve -->
              <path class="dashboard-chart-path" d="M 10 95 Q 80 85 140 50 T 260 40 T 390 15" fill="none" stroke="url(#chartGrad)" stroke-width="3" />
            </svg>
          </div>

          <!-- KPI Metric Bars -->
          <div class="mb-3">
            <div class="d-flex justify-content-between small fw-bold mb-1">
              <span>@(isAr ? "متوسط معدل التحسين في الحملات" : "Average Campaign Improvement")</span>
              <span class="text-gold-light countup-val" data-target="76" data-suffix="%">0%</span>
            </div>
            <div class="progress bg-dark" style="height: 6px;">
              <div class="progress-bar kpi-progress-fill bg-warning" data-width="76%" style="width: 0%;"></div>
            </div>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between small fw-bold mb-1">
              <span>@(isAr ? "انخفاض تكلفة النقرة (CPC)" : "CPC Optimization Efficiency")</span>
              <span class="text-gold-light countup-val" data-target="65" data-suffix="%">0%</span>
            </div>
            <div class="progress bg-dark" style="height: 6px;">
              <div class="progress-bar kpi-progress-fill bg-warning" data-width="65%" style="width: 0%;"></div>
            </div>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between small fw-bold mb-1">
              <span>@(isAr ? "معدل المحادثات المكتملة" : "Conversion Qualification Rate")</span>
              <span class="text-gold-light countup-val" data-target="82" data-suffix="%">0%</span>
            </div>
            <div class="progress bg-dark" style="height: 6px;">
              <div class="progress-bar kpi-progress-fill bg-warning" data-width="82%" style="width: 0%;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================
     8. FEATURED CASE STUDIES & PERFORMANCE
     ========================================== -->
<section class="py-5" id="portfolio" aria-label="Featured Case Studies">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between mb-5">
      <div>
        <div class="section-badge">@Loc["CaseStudiesTitle"]</div>
        <h2 class="section-title m-0">@Loc["CaseStudiesSubtitle"]</h2>
      </div>
      <a asp-controller="Home" asp-action="Portfolio" class="btn-glass mt-3 mt-md-0">
        @Loc["ExploreWork"]
      </a>
    </div>

    <!-- Delicate Animated Luxury Case Study Slider -->
    <div class="delicate-slider-wrapper mb-5" aria-label="Delicate Animated Case Studies Slider">
      <div class="delicate-slides-container">
        @for (int i = 0; i < Model.FeaturedCases.Count; i++)
        {
          var c = Model.FeaturedCases[i];
          <div class="delicate-slide @(i == 0 ? "active-slide" : "")" data-index="@i" aria-hidden="@(i == 0 ? "false" : "true")">
            <div class="row g-4 align-items-center w-100 m-0">
              <!-- Slide Left: Image Showcase -->
              <div class="col-lg-6 p-0 pe-lg-4">
                <div class="delicate-slide-img-box position-relative">
                  <img src="@(c.ImagePath ?? "/images/cases/case-clothing.jpg")" alt="@(isAr ? c.TitleAr : c.TitleEn)" loading="lazy" />
                  <div class="position-absolute top-0 end-0 m-3">
                    <span class="badge px-3 py-2" style="background: rgba(14, 11, 8, 0.88); border: 1px solid var(--gold); color: var(--gold-light); font-size: 0.85rem; backdrop-filter: blur(8px);">
                      @(isAr ? c.IndustryAr : c.IndustryEn)
                    </span>
                  </div>
                  <div class="position-absolute bottom-0 start-0 m-3">
                    <span class="badge px-3 py-1" style="background: rgba(251, 217, 101, 0.15); border: 1px solid rgba(251, 217, 101, 0.4); color: #FFF; font-size: 0.78rem;">
                      @(isAr ? $"دراسة حالة مختارة #{i + 1}" : $"Featured Case #{i + 1}")
                    </span>
                  </div>
                </div>
              </div>

              <!-- Slide Right: Data & Narrative -->
              <div class="col-lg-6 p-0 ps-lg-4">
                <div class="d-inline-flex align-items-center gap-2 section-badge mb-2">
                  <span class="text-gold">✦</span>
                  <span>@(isAr ? c.IndustryAr : c.IndustryEn)</span>
                </div>
                <h3 class="h3 fw-bold text-white mb-3" style="font-family: var(--font-ar); line-height: 1.35;">
                  @(isAr ? c.TitleAr : c.TitleEn)
                </h3>
                <p class="text-cream-soft mb-4" style="line-height: 1.7; font-size: 0.98rem;">
                  @(isAr ? c.DescriptionAr : c.DescriptionEn)
                </p>

                <!-- High-Impact KPI Metrics Row -->
                <div class="row g-2 mb-4">
                  @if (c.Reach.HasValue)
                  {
                    <div class="col-4">
                      <div class="delicate-kpi-pill">
                        <small class="text-white-50 d-block mb-1" style="font-size: 0.75rem;">@(isAr ? "الوصول" : "Reach")</small>
                        <span class="fw-bold text-gold-light fs-5">@c.Reach.Value.ToString("N0")</span>
                      </div>
                    </div>
                  }
                  @if (c.Conversations.HasValue)
                  {
                    <div class="col-4">
                      <div class="delicate-kpi-pill">
                        <small class="text-white-50 d-block mb-1" style="font-size: 0.75rem;">@(isAr ? "المحادثات" : "Convs")</small>
                        <span class="fw-bold text-gold-light fs-5">@c.Conversations.Value.ToString("N0")</span>
                      </div>
                    </div>
                  }
                  @if (c.Cpc.HasValue)
                  {
                    <div class="col-4">
                      <div class="delicate-kpi-pill">
                        <small class="text-white-50 d-block mb-1" style="font-size: 0.75rem;">@(isAr ? "تكلفة النقرة" : "CPC")</small>
                        <span class="fw-bold text-gold-light fs-5">$@c.Cpc.Value.ToString("F2")</span>
                      </div>
                    </div>
                  }
                </div>

                <div class="d-flex align-items-center gap-3">
                  <a asp-controller="Home" asp-action="CaseStudy" asp-route-id="@c.Id" class="btn-gold px-4 py-2">
                    <span>@Loc["ViewCaseDetails"]</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </a>
                  @if (c.Budget.HasValue)
                  {
                    <span class="text-white-50 small">
                      @(isAr ? "الميزانية:" : "Budget:") <strong class="text-white">$@c.Budget.Value.ToString("N0")</strong>
                    </span>
                  }
                </div>
              </div>
            </div>
          </div>
        }
      </div>

      <!-- Slider Controls: Arrows & Animated Dots -->
      <div class="delicate-slider-nav">
        <button type="button" class="delicate-nav-btn delicate-prev-btn" aria-label="@(isAr ? "السابق" : "Previous")">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="@(isAr ? "9 18 15 12 9 6" : "15 18 9 12 15 6")"></polyline></svg>
        </button>

        <div class="delicate-slider-dots">
          @for (int i = 0; i < Model.FeaturedCases.Count; i++)
          {
            <div class="delicate-slider-dot @(i == 0 ? "active" : "")" data-index="@i" role="button" aria-label="Go to slide @(i + 1)"></div>
          }
        </div>

        <button type="button" class="delicate-nav-btn delicate-next-btn" aria-label="@(isAr ? "التالي" : "Next")">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="@(isAr ? "15 18 9 12 15 6" : "9 18 15 12 9 6")"></polyline></svg>
        </button>
      </div>

      <!-- Animated Progress Bar Indicator -->
      <div class="delicate-slider-progress-track">
        <div class="delicate-slider-progress-bar"></div>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================
     9. FINAL DRAMATIC CTA: LET YOUR BRAND BREATHE
     ========================================== -->
<section class="py-5 text-center position-relative overflow-hidden" style="background: radial-gradient(circle at 50% 50%, #291F13 0%, #100D09 80%); border-top: 1px solid rgba(199, 154, 59, 0.25);">
  <div class="container position-relative py-5" style="z-index: 2;">
    <!-- Large breathing glowing ring motif -->
    <div class="breathe-element mb-3">
      <svg width="120" height="120" viewBox="0 0 140 140" class="mx-auto">
        <circle cx="70" cy="70" r="50" fill="none" stroke="url(#preloaderGold)" stroke-width="8" opacity="0.8" />
      </svg>
    </div>

    <div class="display-statement">
      @(isAr ? "دع علامتك تتنفس" : "Let Your Brand Breathe")
    </div>
    <p class="fs-5 text-cream-soft mx-auto mb-4" style="max-width: 650px;">
      @Loc["FinalCtaSubtitle"]
    </p>

    <div class="d-flex justify-content-center gap-3">
      <a href="#contact" class="btn-gold fs-5 px-5 py-3">
        @Loc["GetInTouch"]
      </a>
    </div>
  </div>
</section>

<!-- ==========================================
     10. CONTACT SECTION WITH PROGRESSIVE FORM
     ========================================== -->
<section class="py-5" id="contact" aria-label="Contact Oxygen Marketing">
  <div class="container">
    <div class="text-center mb-5">
      <div class="section-badge">@Loc["NavContact"]</div>
      <h2 class="section-title">@Loc["ContactTitle"]</h2>
      <p class="section-subtitle">@Loc["ContactSubtitle"]</p>
    </div>

    <div class="row g-5">
      <!-- Contact Form Column -->
      <div class="col-lg-7">
        <div class="glass-card p-4 p-md-5">
          <!-- Alert status box -->
          <div id="contact-alert-box" style="display: none;" role="alert"></div>

          <form id="oxygen-contact-form" asp-controller="Home" asp-action="Contact" method="post">
            @Html.AntiForgeryToken()

            <!-- Hidden Honeypot for automated spam bots -->
            <div class="honeypot-field">
              <label for="Website">Do not fill this field</label>
              <input type="text" id="Website" name="Website" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Hidden Campaign Details from Studio -->
            <input type="hidden" id="campaign-details-hidden" name="CampaignDetails" value="" />

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label-custom" for="Name">@Loc["FormName"] *</label>
                <input type="text" id="Name" name="Name" class="form-control-custom" required minlength="2" maxlength="100" placeholder="@(isAr ? "أحمد المحترم" : "John Doe")" />
              </div>

              <div class="col-md-6">
                <label class="form-label-custom" for="Phone">@Loc["FormPhone"] *</label>
                <input type="tel" id="Phone" name="Phone" class="form-control-custom" required maxlength="30" placeholder="+962 7 9000 0000" dir="ltr" />
              </div>

              <div class="col-md-6">
                <label class="form-label-custom" for="Email">@Loc["FormEmail"] *</label>
                <input type="email" id="Email" name="Email" class="form-control-custom" required maxlength="150" placeholder="name@company.com" dir="ltr" />
              </div>

              <div class="col-md-6">
                <label class="form-label-custom" for="Company">@Loc["FormCompany"]</label>
                <input type="text" id="Company" name="Company" class="form-control-custom" maxlength="100" placeholder="@(isAr ? "اسم علامتك التجارية" : "Brand or Agency")" />
              </div>

              <div class="col-12">
                <label class="form-label-custom" for="ServiceId">@Loc["FormService"]</label>
                <select id="ServiceId" name="ServiceId" class="form-select-custom">
                  <option value="">@Loc["FormSelectService"]</option>
                  @foreach (var s in Model.Services)
                  {
                    <option value="@s.Id">@(isAr ? s.TitleAr : s.TitleEn)</option>
                  }
                </select>
              </div>

              <div class="col-12">
                <label class="form-label-custom" for="contact-message-input">@Loc["FormMessage"] *</label>
                <textarea id="contact-message-input" name="Message" rows="5" class="form-control-custom" required minlength="5" maxlength="3000" placeholder="@(isAr ? "اكتب تفاصيل حملتك أو استفسارك هنا..." : "Tell us about your campaign goals, target audience, or requirements...")"></textarea>
              </div>

              <div class="col-12 mt-4">
                <button type="submit" class="btn-gold w-100 py-3 fs-5">
                  <span>@Loc["FormSubmit"]</span>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Contact Info & Google Map Column -->
      <div class="col-lg-5">
        <div class="glass-card p-4 p-md-5 h-100 d-flex flex-column justify-content-between">
          <div>
            <h3 class="h4 fw-bold text-white mb-4">@(isAr ? "مقرنا في عمّان" : "Headquarters in Amman")</h3>
            <ul class="list-unstyled text-cream-soft" style="line-height: 2.2;">
              <li class="d-flex align-items-center gap-3 mb-2">
                <span class="fs-4 text-gold-light">📍</span>
                <span>@Model.Settings.GetValueOrDefault("Address", "Sweifieh, Amman, Jordan")</span>
              </li>
              <li class="d-flex align-items-center gap-3 mb-2">
                <span class="fs-4 text-gold-light">📞</span>
                <a href="tel:@Model.Settings.GetValueOrDefault("Phone", "+962796690421")" class="text-cream-soft text-decoration-none" dir="ltr">
                  @Model.Settings.GetValueOrDefault("Phone", "+962796690421")
                </a>
              </li>
              <li class="d-flex align-items-center gap-3 mb-2">
                <span class="fs-4 text-gold-light">✉️</span>
                <a href="mailto:@Model.Settings.GetValueOrDefault("Email", "infooxygenmedia2022@gmail.com")" class="text-cream-soft text-decoration-none">
                  @Model.Settings.GetValueOrDefault("Email", "infooxygenmedia2022@gmail.com")
                </a>
              </li>
            </ul>

            <!-- Social Links (Facebook & Instagram ONLY) -->
            <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
              <span class="small text-muted d-block mb-3">@(isAr ? "تابعنا على المنصات الرسمية:" : "Follow our official channels:")</span>
              <div class="d-flex gap-2">
                <a href="@Model.Settings.GetValueOrDefault("FacebookUrl", "https://www.facebook.com/oxygenmedia2022/")" target="_blank" rel="noopener noreferrer" class="btn-glass py-2 px-3">
                  Facebook
                </a>
                <a href="@Model.Settings.GetValueOrDefault("InstagramUrl", "https://www.instagram.com/oxygen_consulting__marketing")" target="_blank" rel="noopener noreferrer" class="btn-glass py-2 px-3">
                  Instagram
                </a>
              </div>
            </div>
          </div>

          <!-- Google Maps Iframe Embed for Sweifieh, Amman, Jordan -->
          <div class="mt-4 rounded-3 overflow-hidden border border-secondary border-opacity-25" style="height: 220px;">
            <iframe 
              src="@Model.Settings.GetValueOrDefault("GoogleMapsEmbed", "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13543.123562635952!2d35.859666!3d31.954881!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x151ca118b62dbd63%3A0xe54d9c490cba7fe7!2sAs-Suwayfiyyah%2C%20Amman!5e0!3m2!1sen!2sjo!4v1700000000000!5m2!1sen!2sjo")" 
              width="100%" 
              height="100%" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Oxygen Office Location in Sweifieh, Amman">
            </iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@section Scripts {
  <!-- Home Page Specific Three.js and Studio Interactive scripts -->
  <script type="module" src="~/js/hero3d.js" asp-append-version="true"></script>
  <script src="~/js/studio.js" asp-append-version="true"></script>
  <script src="~/js/scrollStory.js" asp-append-version="true"></script>
  <script src="~/js/radar.js" asp-append-version="true"></script>
}
