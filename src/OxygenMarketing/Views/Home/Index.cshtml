@model OxygenMarketing.ViewModels.HomeViewModel
@using System.Globalization
@{
    var isAr = CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    ViewData["Title"] = isAr ? "مؤسسة أكسجين للاستشارات والتسويق | دع علامتك تتنفس" : "Oxygen Consulting & Marketing | Let Your Brand Breathe";
    ViewData["MetaDescription"] = isAr 
        ? "مؤسسة أكسجين للاستشارات والتسويق — نحوّل الميزانية الإعلانية إلى قرارات مبنية على البيانات. استراتيجيات تسويقية، صناعة محتوى إبداعي، وإدارة حملات مدروسة."
        : "Oxygen Consulting & Marketing — Transforming advertising budgets into data-driven decisions. Social strategy, creative content, and high-performance campaigns.";
}

<!-- ==========================================
     1. 3D HERO SECTION (Three.js Translucent Ring)
     ========================================== -->
<section class="hero-section" id="hero" aria-label="Hero Section">
  <!-- Interactive WebGL Canvas Container -->
  <div id="hero-canvas-container" aria-hidden="true"></div>

  <div class="container hero-content">
    <!-- Oxygen Official Emblem Showcase at Start of Hero Section -->
    <div class="hero-brand-emblem-wrap mb-3" role="img" aria-label="Oxygen Consulting & Marketing">
      <div class="oxygen-orbital-emblem hero-orbital-emblem mx-auto">
        <svg viewBox="0 0 200 200" class="orbital-ring-svg">
          <defs>
            <linearGradient id="heroGoldRing" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#A67422" />
              <stop offset="50%" stop-color="#FBD965" />
              <stop offset="100%" stop-color="#C79A3B" />
            </linearGradient>
            <filter id="heroGoldGlow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="4" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>
          <!-- Outer Golden Orbit Ring -->
          <circle cx="100" cy="100" r="76" fill="none" stroke="url(#heroGoldRing)" stroke-width="10" opacity="0.95" />
          <!-- Inner Dashed Trajectory Ring -->
          <circle cx="100" cy="100" r="56" fill="none" stroke="#FBD965" stroke-width="1.8" stroke-dasharray="5 5" opacity="0.65" class="orbital-dashed-path" />
          <!-- Orbiting Satellite Bead -->
          <g class="orbital-bead-animator">
            <circle cx="155" cy="50" r="9" fill="#FBD965" filter="url(#heroGoldGlow)" />
          </g>
        </svg>
        <!-- Official Logo Centered in Orbit -->
        <div class="orbital-logo-core">
          <img src="~/images/logo-official-dark.png" alt="OXYGEN pure Consulting & Marketing" />
        </div>
      </div>
    </div>

    <!-- Breathing Badge -->
    <div class="d-inline-flex align-items-center gap-2 section-badge breathe-element mb-3">
      <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background: var(--gold-light); box-shadow: 0 0 10px var(--gold-light);"></span>
      <span>@(isAr ? "وكالة استشارات وتسويق رقمي متقدمة" : "Advanced Social Marketing & Consulting")</span>
    </div>

    <!-- Main Headline with Animated Shimmer Gradient Wordmark -->
    <h1 class="hero-title">
      @if (isAr)
      {
        <span>دع علامتك التجارية</span> <span class="gold-gradient-text">تتنفس</span>
      }
      else
      {
        <span>Let Your Brand</span> <span class="gold-gradient-text">Breathe</span>
      }
    </h1>

    <p class="hero-subtitle">
      @(isAr 
        ? "نحوّل الميزانية الإعلانية إلى قرارات مبنية على البيانات. من خلال استراتيجيات تسويقية مدروسة، صناعة محتوى إبداعي، وإدارة حملات تحقق أهدافك وتزيد تفاعل جمهورك."
        : "Transforming advertising budgets into data-driven decisions. High-impact creative content, strategic account management, and verified multi-channel campaigns that elevate brand authority.")
    </p>

    <!-- Action Buttons -->
    <div class="d-flex flex-wrap items-center justify-content-center gap-3 mt-4">
      <a href="#campaign-studio" class="btn-gold">
        <span>@Loc["BuildCampaign"]</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
      <a href="#portfolio" class="btn-glass">
        <span>@Loc["ExploreWork"]</span>
      </a>
    </div>

    <!-- Performance Highlights Bar -->
    <div class="row g-3 justify-content-center mt-5 pt-4 border-top border-secondary border-opacity-25 text-start">
      <div class="col-6 col-md-3 text-center">
        <div class="h2 fw-bold text-gold-light mb-1 gold-gradient-text">+7</div>
        <div class="small text-muted">@Loc["YearsExperience"]</div>
      </div>
      <div class="col-6 col-md-3 text-center">
        <div class="h2 fw-bold text-gold-light mb-1 gold-gradient-text">+5,000</div>
        <div class="small text-muted">@Loc["CampaignsRun"]</div>
      </div>
      <div class="col-6 col-md-3 text-center">
        <div class="h2 fw-bold text-gold-light mb-1 gold-gradient-text">@(isAr ? "محلي ودولي" : "Local & Global")</div>
        <div class="small text-muted">@Loc["HighlightsLocalGlobal"]</div>
      </div>
      <div class="col-6 col-md-3 text-center">
        <div class="h2 fw-bold text-gold-light mb-1 gold-gradient-text">100%</div>
        <div class="small text-muted">@Loc["HighlightsMethod"]</div>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================
     2. ACCREDITED GLOBAL PLATFORMS & TACTICAL ECOSYSTEM
     ========================================== -->
<section class="platforms-ecosystem-section" id="platforms" aria-label="Official Advertising Platforms and Capabilities">
  <div class="platforms-eco-glow"></div>
  
  <div class="container position-relative" style="z-index: 2;">
    <!-- Section Header -->
    <div class="text-center mb-5">
      <div class="d-inline-flex align-items-center gap-2 section-badge mb-3">
        <span class="text-gold">✦</span>
        <span>@(isAr ? "منظومة المنصات الإعلانية المعتمدة" : "Accredited Global Ad Networks")</span>
        <span class="text-gold">✦</span>
      </div>
      <h2 class="section-title text-center mb-2">
        @(isAr ? "شراكات واستهداف مباشر بأعلى عائد استثماري" : "Direct Multi-Platform Execution with Proven ROAS")
      </h2>
      <p class="section-subtitle text-center mx-auto" style="max-width: 720px;">
        @(isAr 
          ? "ندير ونوجّه ميزانيتك على أقوى المنصات العالمية وفق خوارزميات الذكاء الاصطناعي والاستهداف الدقيق لتحقيق أعلى ربحية وأقل تكلفة استحواذ."
          : "We engineer and scale advertising campaigns directly across premier global networks using precision micro-targeting and algorithmic optimization.")
      </p>
    </div>

    <!-- 1. The 6 Major Accredited Platforms (Clean 3-Column Luxury Grid) -->
    <div class="platform-card-grid">
      <!-- 1. Meta (Facebook & Instagram) -->
      <div class="platform-eco-card">
        <div>
          <div class="platform-eco-header">
            <div class="platform-eco-icon-wrap">
              <div class="platform-eco-icon" style="background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </div>
              <div>
                <h3 class="platform-eco-title">Instagram & Meta</h3>
                <span class="platform-eco-tag">Meta Advantage+</span>
              </div>
            </div>
            <span class="platform-eco-badge">@(isAr ? "ذكاء اصطناعي وبكسل" : "Pixel AI Engine")</span>
          </div>
          <p class="platform-eco-desc">
            @(isAr 
              ? "إدارة متقدمة لحملات التحويل وإعادة الاستهداف الذكية للوصول للجمهور الأكثر استعداداً للشراء ورفع التفاعل الفوري."
              : "Advanced conversion campaigns, intelligent pixel retargeting, and high-intent customer acquisition funnels.")
          </p>
        </div>
        <div class="platform-eco-footer">
          <span class="platform-eco-kpi">
            <span>@(isAr ? "متوسط العائد:" : "Avg ROAS:")</span>
            <span class="platform-eco-kpi-val">+380% ROAS</span>
          </span>
          <span class="text-white-50 small">@(isAr ? "استحواذ فوري" : "Instant Growth")</span>
        </div>
      </div>

      <!-- 2. TikTok for Business -->
      <div class="platform-eco-card">
        <div>
          <div class="platform-eco-header">
            <div class="platform-eco-icon-wrap">
              <div class="platform-eco-icon" style="background: #010101; border: 1px solid rgba(255,255,255,0.2);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="#00f2fe">
                  <path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-2.891 2.892 2.896 2.896 0 0 1-2.892-2.892 2.896 2.896 0 0 1 2.892-2.892c.38 0 .741.076 1.073.214V9.43a6.34 6.34 0 0 0-1.073-.092A6.343 6.343 0 0 0 3 15.68a6.343 6.343 0 0 0 6.344 6.344 6.343 6.343 0 0 0 6.344-6.344V8.897a8.21 8.21 0 0 0 4.902 1.603V7.054a4.808 4.808 0 0 1-1-.368z" fill="#FE2C55" />
                </svg>
              </div>
              <div>
                <h3 class="platform-eco-title">TikTok for Business</h3>
                <span class="platform-eco-tag">Spark Ads & Viral</span>
              </div>
            </div>
            <span class="platform-eco-badge">@(isAr ? "انتشار فيروسي" : "Viral Impact")</span>
          </div>
          <p class="platform-eco-desc">
            @(isAr 
              ? "إنتاج فيديوهات خطافية سريعة تجتاح المنصة واستثمار إعلانات Spark Ads للوصول لأعلى معدلات حفظ ومشاركة ومبيعات."
              : "High-retention 3-second hook creatives and Spark Ad acceleration for viral reach and audience conversion.")
          </p>
        </div>
        <div class="platform-eco-footer">
          <span class="platform-eco-kpi">
            <span>@(isAr ? "معدل الحفظ:" : "Save Rate:")</span>
            <span class="platform-eco-kpi-val">+420%</span>
          </span>
          <span class="text-white-50 small">@(isAr ? "ترندات مدروسة" : "Trend Strategy")</span>
        </div>
      </div>

      <!-- 3. Google PPC & Search -->
      <div class="platform-eco-card">
        <div>
          <div class="platform-eco-header">
            <div class="platform-eco-icon-wrap">
              <div class="platform-eco-icon" style="background: #FFFFFF;">
                <svg width="24" height="24" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.65v3.03h3.88c2.27-2.09 3.66-5.17 3.66-9.12z" />
                  <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.03c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.13C3.25 21.37 7.31 24 12 24z" />
                  <path fill="#FBBC05" d="M5.28 14.29c-.25-.72-.38-1.49-.38-2.29s.13-1.57.38-2.29V6.58H1.25C.45 8.17 0 9.97 0 12s.45 3.83 1.25 5.42l4.03-3.13z" />
                  <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.25 2.63 1.25 6.58l4.03 3.13c.95-2.83 3.6-4.96 6.72-4.96z" />
                </svg>
              </div>
              <div>
                <h3 class="platform-eco-title">Google Search & PPC</h3>
                <span class="platform-eco-tag">High-Intent Keywords</span>
              </div>
            </div>
            <span class="platform-eco-badge">@(isAr ? "زبون جاهز للشراء" : "Ready Buyer")</span>
          </div>
          <p class="platform-eco-desc">
            @(isAr 
              ? "الظهور الحصري في صدارة نتائج البحث أمام الزبون المستعد للشراء لحظة بحثه عن خدمتك أو منتجك بأقل تكلفة نقرة."
              : "Dominating search engine results when customers are actively searching to buy your specific services.")
          </p>
        </div>
        <div class="platform-eco-footer">
          <span class="platform-eco-kpi">
            <span>@(isAr ? "تكلفة النقرة:" : "CPC Efficiency:")</span>
            <span class="platform-eco-kpi-val">-45% CPC</span>
          </span>
          <span class="text-white-50 small">@(isAr ? "أعلى جودة طلب" : "High Intent")</span>
        </div>
      </div>

      <!-- 4. Snapchat Direct Ads -->
      <div class="platform-eco-card">
        <div>
          <div class="platform-eco-header">
            <div class="platform-eco-icon-wrap">
              <div class="platform-eco-icon" style="background: #FFFC00;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="#000000">
                  <path d="M12.001 2.25c-4.135 0-6.19 3.033-6.19 5.86 0 1.258.45 2.505 1.096 3.428-.157.514-.77 1.03-1.637 1.266-.34.093-.578.4-.578.752 0 .412.316.755.728.795.733.072 1.408.384 1.83 1.03.208.318.15.74-.138 1-.502.453-1.42 1.085-2.614 1.348-.31.069-.533.342-.533.66 0 .408.361.733.766.697 1.638-.145 3.32-.873 4.29-1.57.545-.392 1.25-.456 1.85-.169.69.33 1.455.503 2.224.503.77 0 1.535-.173 2.224-.503.6-.287 1.305-.223 1.85.169.97.697 2.652 1.425 4.29 1.57.405.036.766-.289.766-.697 0-.318-.223-.591-.533-.66-1.194-.263-2.112-.895-2.614-1.348-.288-.26-.346-.682-.138-1 .422-.646 1.097-.958 1.83-1.03.412-.04.728-.383.728-.795 0-.352-.238-.659-.578-.752-.867-.236-1.48-.752-1.637-1.266.646-.923 1.096-2.17 1.096-3.428 0-2.827-2.055-5.86-6.19-5.86z"></path>
                </svg>
              </div>
              <div>
                <h3 class="platform-eco-title">Snapchat Direct Ads</h3>
                <span class="platform-eco-tag">Swipe-Up & Chat</span>
              </div>
            </div>
            <span class="platform-eco-badge">@(isAr ? "محادثات مبيعات فورية" : "Direct Chat")</span>
          </div>
          <p class="platform-eco-desc">
            @(isAr 
              ? "إعلانات تفاعلية كاملة الشاشة تفتح محادثات مباشرة فورية مع الزبائن للشراء والحجز السريع لقطاعات العيادات والتجزئة."
              : "Full-screen vertical formats tailored for direct sales inquiries, appointment booking, and instant conversions.")
          </p>
        </div>
        <div class="platform-eco-footer">
          <span class="platform-eco-kpi">
            <span>@(isAr ? "سرعة الاستجابة:" : "Direct Convs:")</span>
            <span class="platform-eco-kpi-val">+5,000+</span>
          </span>
          <span class="text-white-50 small">@(isAr ? "حجز واستفسار فوري" : "Direct Leads")</span>
        </div>
      </div>

      <!-- 5. LinkedIn B2B Ads -->
      <div class="platform-eco-card">
        <div>
          <div class="platform-eco-header">
            <div class="platform-eco-icon-wrap">
              <div class="platform-eco-icon" style="background: #0A66C2;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="#FFFFFF">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0-.02-3.28 1.64 1.64 0 0 0 .02 3.28M5.07 18.5h2.79v-8.37H5.07v8.37z"></path>
                </svg>
              </div>
              <div>
                <h3 class="platform-eco-title">LinkedIn B2B Ads</h3>
                <span class="platform-eco-tag">Enterprise Decision Makers</span>
              </div>
            </div>
            <span class="platform-eco-badge">@(isAr ? "استهداف الشركات" : "Corporate B2B")</span>
          </div>
          <p class="platform-eco-desc">
            @(isAr 
              ? "استهداف دقيق بالمنصب الوظيفي والقطاع للوصول للمدراء التنفيذيين وأصحاب القرار لصفقات الشركات والخدمات الراقية."
              : "Hyper-targeted B2B campaigns reaching C-level executives, corporate buyers, and enterprise stakeholders.")
          </p>
        </div>
        <div class="platform-eco-footer">
          <span class="platform-eco-kpi">
            <span>@(isAr ? "دقة الاستهداف:" : "Accuracy:")</span>
            <span class="platform-eco-kpi-val">99% B2B</span>
          </span>
          <span class="text-white-50 small">@(isAr ? "صفقات كبرى" : "High Ticket")</span>
        </div>
      </div>

      <!-- 6. WhatsApp Conversions Funnel -->
      <div class="platform-eco-card">
        <div>
          <div class="platform-eco-header">
            <div class="platform-eco-icon-wrap">
              <div class="platform-eco-icon" style="background: #25D366;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="#FFFFFF">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"></path>
                </svg>
              </div>
              <div>
                <h3 class="platform-eco-title">WhatsApp Conversions</h3>
                <span class="platform-eco-tag">Direct Sales Funnels</span>
              </div>
            </div>
            <span class="platform-eco-badge">@(isAr ? "إغلاق مبيعات فوري" : "Instant Closures")</span>
          </div>
          <p class="platform-eco-desc">
            @(isAr 
              ? "مسارات تحويل ذكية تربط الحملات الإعلانية مباشرة بمحادثات واتساب مخصصة لإتمام عمليات البيع مع فريقك فوراً."
              : "Streamlined click-to-WhatsApp funnels connecting ready shoppers directly to your sales team for instant closing.")
          </p>
        </div>
        <div class="platform-eco-footer">
          <span class="platform-eco-kpi">
            <span>@(isAr ? "معدل الإغلاق:" : "Close Rate:")</span>
            <span class="platform-eco-kpi-val">+65%</span>
          </span>
          <span class="text-white-50 small">@(isAr ? "تحويلات مباشرة" : "Direct Funnels")</span>
        </div>
      </div>
    </div>

    <!-- 2. The 4 Tactical Superpowers (Organized 4-Column Row) -->
    <div class="tactical-pillars-section">
      <div class="tactical-pillars-header">
        <h3 class="h4 fw-bold text-white mb-2">
          @(isAr ? "الركائز التكتيكية الأربع لقوة أكسجين" : "The 4 Tactical Pillars of Oxygen Execution")
        </h3>
        <p class="text-white-50 small m-0">
          @(isAr ? "معايير دقيقة تحكم كل حملة إعلانية نطلقها لضمان عدم إهدار أي دولار" : "The non-negotiable execution standards behind every campaign we scale.")
        </p>
      </div>

      <div class="tactical-pillars-grid">
        <!-- Pillar 1 -->
        <div class="tactical-pillar-card">
          <span class="tactical-pillar-icon">💎</span>
          <h4 class="tactical-pillar-title">@(isAr ? "بيانات وقرارات مدروسة" : "Data-Driven Decisions")</h4>
          <p class="tactical-pillar-desc">
            @(isAr ? "لا نعتمد على التخمين مطلقاً؛ كل دولار يتم تحليله عبر تجارب A/B مستمرة لضمان أعلى عائد استثماري." : "Zero guesswork. Every dollar is backed by empirical analytics, variant testing, and ROI optimization.")
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="tactical-pillar-card">
          <span class="tactical-pillar-icon">🎯</span>
          <h4 class="tactical-pillar-title">@(isAr ? "استهداف ميكرو دقيق" : "High-Intent Micro-Targeting")</h4>
          <p class="tactical-pillar-desc">
            @(isAr ? "نحدد الجمهور بناءً على نية الشراء الحقيقية والسلوك الرقمي الفعلي، لنصل للعميل الجاهز للدفع." : "Reaching buyers with verified purchasing intent and real behavior, not casual passive scrollers.")
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="tactical-pillar-card">
          <span class="tactical-pillar-icon">🎬</span>
          <h4 class="tactical-pillar-title">@(isAr ? "صناعة محتوى سينمائي" : "Cinematic 3-Second Hooks")</h4>
          <p class="tactical-pillar-desc">
            @(isAr ? "سيناريوهات وتصوير يشد انتباه العميل في أول 3 ثوانٍ ليمنعه من التمرير ويقنعه باتخاذ القرار." : "Compelling video creative engineered with arresting visual hooks that stop the scroll and drive action.")
          </p>
        </div>

        <!-- Pillar 4 -->
        <div class="tactical-pillar-card">
